PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/abdull_ecommerce
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173

# Stripe card payments (optional). Use TEST keys from https://dashboard.stripe.com/test/apikeys
# Outside NODE_ENV=production only sk_test_ keys are accepted.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...). For local testing: stripe listen --forward-to localhost:5000/api/payments/webhook
STRIPE_WEBHOOK_SECRET=

# Passwords given to the admin@abdull.com and customer@abdull.com accounts by "npm run seed".
# Leave empty to use the demo passwords from the README. Never commit real passwords.
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
